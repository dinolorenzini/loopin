{
  "name": "loopin",
  "version": "1.0.0",
  "private": true,
  "description": "Loopin - Ultra-fast, ephemeral real-time chat powered 100% by Cloudflare Workers & Durable Objects",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "build:client": "vite build",
    "dev": "wrangler dev",
    "build": "vite build",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node test/compliance-test.mjs && node --use-system-ca test/gif-and-qr-test.mjs",
    "test:compliance": "node test/compliance-test.mjs",
    "test:all": "node test/compliance-test.mjs && node --use-system-ca test/gif-and-qr-test.mjs && node test/new-features-and-conflicts-test.mjs && node test/batch-features-test.mjs && node test/security-test.mjs && node test/ws-test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsqr": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.155.0"
  }
}
